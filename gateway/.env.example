# Robot AI gateway configuration. Copy to .env for local runs, or set these as environment
# variables / secrets on your hosting platform. NEVER commit real keys or put them on the robot.

# ---------------------------------------------------------------- providers
# Keyless demo (works out of the box): STT=mock  LLM=mock  TTS=espeak (or mock)
# Default with a Groq key (free plan, docs/VERCEL_SETUP.md): STT=groq  LLM=groq  TTS=groq (speaker) or mock
# Claude instead (needs Anthropic credits, docs/CLAUDE_SETUP.md): LLM=anthropic
# Unset STT_PROVIDER / LLM_PROVIDER = groq when GROQ_API_KEY is set, otherwise mock.
STT_PROVIDER=groq          # mock | groq | openai | openai_compatible
LLM_PROVIDER=groq          # mock | groq | anthropic | openai
TTS_PROVIDER=mock          # mock | groq | espeak | openai   (groq = natural Orpheus voice)

# Groq: one key for Whisper speech recognition, the language model and the Orpheus voice.
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b   # any Groq chat model id
GROQ_REASONING_EFFORT=low            # gpt-oss: low | medium | high (low = fast, fewer tokens)
LLM_MAX_TOKENS=1024                  # reasoning + answer
LLM_TEMPERATURE=0.6
GROQ_TTS_VOICE_EN=hannah             # autumn diana hannah austin daniel troy
GROQ_TTS_VOICE_AR=lulwa              # abdullah fahad sultan lulwa noura aisha
GROQ_TTS_MODEL_EN=canopylabs/orpheus-v1-english
GROQ_TTS_MODEL_AR=canopylabs/orpheus-arabic-saudi
GROQ_TTS_MAX_CHUNKS=2                # pieces of <= 200 characters spoken per answer (free quota ~100/day)

# Claude (LLM_PROVIDER=anthropic, optional). An Anthropic Console API key with prepaid credits.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5   # fast, low cost; claude-sonnet-5-5 / claude-opus-5-5 for more capability
ANTHROPIC_EFFORT=low       # low keeps answers quick; raise for harder tutoring
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_FALLBACKS=true   # used only by models that support server-side fallbacks (not Haiku 5.5)

# Speech-to-text. groq = Whisper Large v3 Turbo (Arabic + English), uses GROQ_API_KEY above
STT_MODEL=                 # optional override (groq default: whisper-large-v3-turbo)
STT_BASE_URL=              # optional override of the provider endpoint
STT_API_KEY=               # optional: one key variable for any OpenAI-compatible STT service
MIN_VOICED_SECONDS=0.25    # quieter audio is ignored without calling the paid STT
VOICE_RMS=150

# OpenAI (STT_PROVIDER=openai, TTS_PROVIDER=openai, LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=          # a current transcription model (older ones are being retired - check OpenAI docs)
OPENAI_TTS_MODEL=          # set to a current speech model
OPENAI_TTS_VOICE=alloy
OPENAI_LLM_MODEL=

# ---------------------------------------------------------------- robots
# Either a registry file created with:  python -m robot_gateway.devices add robot-1
DEVICES_FILE=devices.json
# ...or inline hashes (handy on container platforms):  robot-1:<sha256 of token>
DEVICE_TOKEN_HASHES=

ROBOT_NAME=Robo

# ---------------------------------------------------------------- conversation memory
# Random text, 32+ characters (python -c "import secrets; print(secrets.token_urlsafe(48))").
# Seals the conversation token the robot carries between turns. REQUIRED on Vercel/serverless
# hosts so every instance can read it; changing it only makes robots start a fresh conversation.
CONTEXT_SECRET=
GATEWAY_STATELESS=auto       # auto = on when running on Vercel; 1 = never use process memory
CONTEXT_MAX_CHARS=2400       # token size cap (the robot accepts up to 3000)
CONTEXT_HISTORY_TURNS=4      # exchanges carried in the token for the language model

# ---------------------------------------------------------------- limits & privacy
MAX_AUDIO_SECONDS=15
TURNS_PER_MINUTE=20
TURNS_PER_DAY=1500
AUDIO_TTL_SECONDS=120
SESSION_TTL_SECONDS=1800
LOG_TRANSCRIPTS=false        # children's speech is not logged unless you opt in
ALLOW_DEBUG_TRANSCRIPT=false # test-only header; keep false in production
